# Pooler en modo transaccion (puerto 6543). Es la que usa la app en Vercel.
# Requiere `prepare: false` en el cliente de postgres.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Conexion directa (puerto 5432). Solo para drizzle-kit: las migraciones
# necesitan una sesion propia para tomar el lock.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Fase 2 en adelante.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Fase 4. Sin NEXT_PUBLIC_, nunca: iria al bundle del navegador.
TMDB_API_KEY=""

# Clave secreta de Supabase (Settings → API Keys → Secret key, `sb_secret_…`).
# Solo servidor: crea la cuenta cuando alguien canjea una invitación.
SUPABASE_SECRET_KEY=""

# Notificaciones push. Se generan una vez con: npx web-push generate-vapid-keys
# La pública va al navegador; la privada, nunca. Sin estas dos no se mandan
# avisos y la app sigue andando igual.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Un mail de contacto para los servicios de push (Apple, Google).
VAPID_SUBJECT="mailto:vos@ejemplo.com"
